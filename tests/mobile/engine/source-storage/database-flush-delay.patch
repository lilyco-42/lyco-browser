+# How long localStorage database changes are batched before a write is queued.
+# This is independent of snapshot idle/checkpoint timing. Zero queues an earlier
+# asynchronous write; it does not provide a synchronous durability fence.
+- name: dom.storage.database.flushIntervalMs
+  type: RelaxedAtomicUint32
+  value: 5000
+  mirror: always
