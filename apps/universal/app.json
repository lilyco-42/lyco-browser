{
  "expo": {
    "name": "LYCO Browser",
    "slug": "lyco-browser",
    "scheme": "lycobrowser",
    "icon": "../../resources/branding/icon-source.png",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "top.lain42.lycobrowser",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "../../resources/branding/icon-source.png",
        "backgroundColor": "#121016"
      },
      "permissions": [
        "INTERNET"
      ]
    },
    "ios": {
      "bundleIdentifier": "top.lain42.lycobrowser",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoadsInWebContent": true
        }
      }
    },
    "web": {
      "bundler": "metro",
      "name": "LYCO Browser",
      "shortName": "LYCO"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 28,
            "usesCleartextTraffic": true
          },
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ]
    ]
  }
}
